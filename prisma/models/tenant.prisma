model Tenant {
  id        String    @id @default(uuid())
  name      String
  domain    String?   @unique
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  roles       Role[]
  permissions Permission[]
  systemLogs  SystemLog[]

  @@index([isActive])
  @@index([deletedAt])
}
