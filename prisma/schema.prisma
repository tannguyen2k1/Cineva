// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  domain      String?   @unique
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  roles       Role[]
  permissions Permission[]
  systemLogs  SystemLog[]

  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id          String    @id @default(uuid())
  username    String
  email       String?
  password    String
  fullName    String?
  avatar      String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  // Base fields
  tenant_id   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  systemLogs  SystemLog[]

  // Unique active username enforced in app (soft-delete friendly)
  @@index([tenant_id])
  @@index([tenant_id, username])
  @@index([tenant_id, isActive])
  @@index([tenant_id, deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?
  deletedAt   DateTime?

  // Base fields
  tenant_id   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  rolePerms   RolePermission[]

  @@index([tenant_id])
  @@index([tenant_id, name])
  @@index([tenant_id, deletedAt])
}

model Permission {
  id          String   @id @default(uuid())
  action      String   // e.g., "create", "read", "update", "delete"
  resource    String   // e.g., "users", "posts"
  description String?
  
  // Base fields
  tenant_id   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  rolePerms   RolePermission[]

  @@unique([tenant_id, action, resource]) 
  @@index([tenant_id])
  @@index([tenant_id, resource]) // Optimize cho việc query tất cả action của 1 resource
}

model UserRole {
  id          String   @id @default(uuid())
  
  // Foreign Keys
  user_id     String
  role_id     String
  tenant_id   String

  // Relations
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([tenant_id])
  @@index([tenant_id, user_id])
  @@index([tenant_id, role_id])
}

model RolePermission {
  id            String   @id @default(uuid())
  
  // Foreign Keys
  role_id       String
  permission_id String
  tenant_id     String

  // Relations
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([tenant_id])
  @@index([tenant_id, role_id])
}

model SystemLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "CREATE_USER", "LOGIN"
  resource    String?  // e.g. "User", "Role"
  details     String?  // JSON string format for extra data
  
  // Base fields
  tenant_id   String
  user_id     String?
  createdAt   DateTime @default(now())

  // Relations
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([tenant_id, createdAt])
}
