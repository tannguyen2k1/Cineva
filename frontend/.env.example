# Cloudflare Turnstile site key (widget). Secret verify nằm ở backend/.env
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Proxy /api → FastAPI (mặc định http://127.0.0.1:8000 nếu bỏ trống)
NUXT_API_PROXY=http://127.0.0.1:8000

# WebSocket FastAPI (mặc định suy ra từ NUXT_API_PROXY)
NUXT_PUBLIC_WS_BASE=ws://127.0.0.1:8000
