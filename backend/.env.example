DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/app_db
JWT_SECRET=change-me
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# development → 500 responses include debug.type/detail/traceback
# production  → generic 500 messages only (no internals)
ENVIRONMENT=development
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000

# Per-IP requests / minute (0 disables that bucket)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_WS_TICKET=20
RATE_LIMIT_API=120
