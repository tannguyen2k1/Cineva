DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/cineva
JWT_SECRET=change-me
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# development → 500 responses include debug.type/detail/traceback
# production  → generic 500 messages only (no internals)
ENVIRONMENT=development
UPLOAD_DIR=uploads
# Explicit origins (Nuxt). In development, any localhost/127.0.0.1 port is also allowed (Flutter web).
CORS_ORIGINS=http://localhost:3000

# Per-IP requests / minute (0 disables that bucket)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_WS_TICKET=20
RATE_LIMIT_API=120

# KKPhim catalog API (phimapi.com)
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_TIMEOUT_SECONDS=20
KKPHIM_MAX_RETRIES=4
KKPHIM_RETRY_BASE_SECONDS=0.75
KKPHIM_REQUEST_DELAY_SECONDS=0.1
SYNC_MAX_PAGES_PER_RUN=30

# Local poster/thumbnail mirror
FILM_IMAGE_CONCURRENCY=4
FILM_IMAGE_TIMEOUT_SECONDS=25
FILM_IMAGE_MAX_BYTES=8388608
FILM_IMAGE_MAX_PIXELS=30000000
FILM_IMAGE_MAX_RETRIES=3
